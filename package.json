{
	"name": "hng-todo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "ENV_FILE=.env.prod drizzle-kit migrate",
		"seed:user": "tsx scripts/seed-user.ts",
		"seed:user:prod": "ENV_FILE=.env.prod tsx scripts/seed-user.ts",
		"user:add": "tsx scripts/user-add.ts",
		"user:add:prod": "ENV_FILE=.env.prod tsx scripts/user-add.ts"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.3",
		"dotenv": "^18.0.4",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.1",
		"pg": "^8.23.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@node-rs/argon2": "^2.2.1",
		"chrono-node": "^2.10.1",
		"drizzle-orm": "^0.45.3",
		"fractional-indexing": "^4.0.0",
		"svelte-dnd-action": "^0.9.79"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22"
	}
}
