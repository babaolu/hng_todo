# Neon connection string (use the pooled "-pooler" host). Read by the app, migrations and the seed.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: Neon's direct (non-pooler) host. `pnpm db:migrate` uses it when set, since
# drizzle-kit connects over TCP. Not needed by the app.
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Only read by `pnpm seed:user` to create/update the single account. Never read by the running app.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Temporary guest mode: "on" shows "Continue as guest" on /login. Anything else (or unset) is off,
# and while it's off every guest account and its data is deleted.
GUEST_MODE=off
